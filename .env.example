# Copy to .env and fill in.  .env is gitignored; .env.example is not.
# NEVER put a key file inside the repository, even gitignored — an ignore
# rule protects you only until someone runs `git add -f` or changes the path.
# Keep credentials outside the working tree, e.g. ~/.config/kalshi/.

# --- Polymarket ---
POLYMARKET_API_KEY=

# --- Kalshi: Option A, simple bearer token ---
KALSHI_API_KEY=

# --- Kalshi: Option B, RSA key file from the dashboard ---
# kalshi.com -> Settings -> API Keys -> Create Key -> Download .pem
KALSHI_KEY_ID=
KALSHI_KEY_FILE=/Users/you/.config/kalshi/kalshi_api_key.pem
